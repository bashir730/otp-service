NODE_ENV=development
PORT=3000

# SQLite database path
DATABASE_PATH=./data/otp.sqlite

# Redis connection
REDIS_URL=redis://localhost:6379

# OTP settings
OTP_LENGTH=6
OTP_EXPIRES_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Rate limits (requests per 60s)
RATE_LIMIT_PER_IP=20
RATE_LIMIT_PER_PHONE=3
RATE_LIMIT_PER_CLIENT=60

CORS_ORIGIN=*
LOG_LEVEL=info

# Default region for phone normalization (libphonenumber region code)
DEFAULT_REGION=AF

# Connect WhatsApp automatically on boot
WHATSAPP_AUTO_CONNECT=true

# Admin key for /api/v1/clients management — CHANGE THIS
ADMIN_KEY=change-me-long-random-admin-key

# Pepper for OTP hashing — random long string, keep stable across restarts
OTP_PEPPER=change-me-long-random-pepper

# OTP message template ({code} and {minutes} are replaced)
OTP_MESSAGE_TEMPLATE=Your verification code:\n{code}\n\nThis code is valid for {minutes} minutes.\nIf you did not request this, ignore this message.
