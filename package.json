{
  "name": "otp-service",
  "version": "1.0.0",
  "description": "Central OTP Verification Service — sends OTP codes via WhatsApp (Baileys) with REST API, SQLite, Redis, rate limiting",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && cp -r src/database/schema.sql src/database/migrations dist/database/",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "client:add": "tsx src/scripts/add-client.ts"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@types/qrcode": "^1.5.6",
    "@whiskeysockets/baileys": "^6.7.18",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "libphonenumber-js": "^1.11.16",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/qrcode-terminal": "^0.12.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
